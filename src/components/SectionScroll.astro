---
/**
 * Moves the page one section per gesture or keypress. The page genuinely
 * scrolls — this only decides where a gesture lands — so the browser scrollbar
 * travels with it and there is no fade or slide transition anywhere.
 * Sizing and snapping live under `html.snap` in styles.css.
 */
---

<script>
  /** A section must overflow by more than this before it scrolls internally. */
  const OVERFLOW_SLACK = 24;
  /** Wheel quiet for this long starts a fresh burst. */
  const BURST_GAP_MS = 250;
  /** Below this share of the burst's peak, a wheel event is momentum, not input. */
  const DECAY_RATIO = 0.4;
  /** Wheel distance that adds up to one step. */
  const STEP_DELTA = 12;

  const root = document.documentElement;
  const main = document.querySelector<HTMLElement>("main");
  if (main && root.classList.contains("snap")) init(main);

  function init(main: HTMLElement) {
    const sections = Array.from(main.children).filter(
      (el): el is HTMLElement => el instanceof HTMLElement && el.matches("section[id], footer[id]"),
    );
    if (sections.length < 2) return;

    const header = document.querySelector("header");
    // Kept in sync with the CSS so section heights, scroll-padding and these
    // measurements can never disagree by the header's border.
    function headerHeight() {
      return header ? Math.round(header.getBoundingClientRect().height) : 64;
    }
    function syncHeaderVar() {
      root.style.setProperty("--header-h", `${headerHeight()}px`);
    }
    syncHeaderVar();
    window.addEventListener("resize", syncHeaderVar);

    const topOf = (s: HTMLElement) =>
      Math.round(s.getBoundingClientRect().top + window.scrollY - headerHeight());

    /** The section currently filling the screen. */
    function currentIndex() {
      const y = window.scrollY + 4;
      let i = 0;
      sections.forEach((s, n) => {
        if (topOf(s) <= y) i = n;
      });
      return i;
    }

    // Where the page is headed. Tracked separately from currentIndex() so a
    // second gesture during the glide moves on from the destination rather than
    // from wherever the animation happens to be — the fixed lock this replaces
    // dropped those gestures entirely, which read as the page sticking.
    let target = currentIndex();
    let animating = false;
    let retries = 0;
    // True from the moment a move starts until the page comes to rest. One step
    // per glide is the whole pacing rule for the wheel.
    let busy = false;

    function go(i: number) {
      const next = Math.max(0, Math.min(sections.length - 1, i));
      if (next === target && Math.abs(window.scrollY - topOf(sections[next])) < 2) return;
      target = next;
      animating = true;
      busy = true;
      retries = 0;
      window.scrollTo({ top: topOf(sections[next]), behavior: "smooth" });
    }

    let restTimer = 0;
    window.addEventListener(
      "scroll",
      () => {
        window.clearTimeout(restTimer);
        restTimer = window.setTimeout(() => {
          const at = currentIndex();
          // Retargeting mid-glide occasionally loses to the snap engine, which
          // pulls back to the point it was already heading for. Finish the job
          // rather than silently dropping the gesture.
          if (animating && at !== target && retries < 2) {
            retries += 1;
            window.scrollTo({ top: topOf(sections[target]), behavior: "smooth" });
            return;
          }
          // Only adopt the resting position once nothing of ours is in flight —
          // otherwise a mid-glide reading overwrites the destination and the
          // next gesture re-aims at the section already being travelled to.
          animating = false;
          busy = false;
          target = at;
        }, 120);
      },
      { passive: true },
    );

    /**
     * One notch, one screenful. A section taller than the screen — because a
     * FAQ item opened, or because the browser is zoomed, which shrinks the
     * viewport without shrinking content — is stepped through a screen at a
     * time rather than handed to native scrolling, which crawls ~100px a notch
     * and reads as the page sticking. Returns false once it is fully seen, so
     * the next notch moves to the neighbouring section.
     */
    function stepWithin(dir: number) {
      const h = headerHeight();
      const view = window.innerHeight - h;
      const r = sections[currentIndex()].getBoundingClientRect();
      if (r.height <= view + OVERFLOW_SLACK) return false;

      const room = dir > 0 ? r.bottom - window.innerHeight : h - r.top;
      if (room <= 1) return false;

      busy = true;
      window.scrollTo({
        top: window.scrollY + dir * Math.min(view * 0.85, room),
        behavior: "smooth",
      });
      return true;
    }

    // The mobile menu locks scrolling; nothing here should fight it.
    const blocked = () => root.style.overflow === "hidden";

    let lastWheel = 0;
    let peak = 0;
    let acc = 0;

    // Snap alone can't carry this: a wheel notch is ~100px against a ~720px
    // section, so mandatory snap pulls every notch straight back and the page
    // never moves at all. So the wheel is assisted, on two rules only — one
    // step per glide, and momentum doesn't count as input. Earlier attempts
    // paced on how long a gesture had been going, which cannot separate "still
    // scrolling" from "coasting": every threshold that stopped a flick reaching
    // the footer also froze a held scroll. Snapping now backs all of this up,
    // so even a step that goes astray still rests on a section boundary.
    window.addEventListener(
      "wheel",
      (e) => {
        if (e.ctrlKey || blocked()) return;
        const delta = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        e.preventDefault();

        const now = e.timeStamp;
        // A gap this long means the user let go and pushed again. Momentum is
        // continuous, so it can never look like this — which makes a fresh
        // burst safe to act on immediately, mid-glide included. That is what
        // stops deliberate notches being swallowed while the page is moving.
        const freshBurst = now - lastWheel > BURST_GAP_MS;
        if (freshBurst) {
          acc = 0;
          peak = 0;
        }
        lastWheel = now;
        peak = Math.max(peak, Math.abs(delta));

        if (!freshBurst) {
          // Still one continuous gesture: pace it to one step per glide...
          if (busy) {
            acc = 0;
            return;
          }
          // ...and ignore the coasting tail. Momentum decays, a push doesn't;
          // comparing against the burst's own peak separates them at any speed,
          // where an absolute floor would also throw away a slow, gentle drag.
          if (Math.abs(delta) < peak * DECAY_RATIO) return;
        }

        acc += delta;
        if (Math.abs(acc) < STEP_DELTA) return;

        const dir = acc > 0 ? 1 : -1;
        acc = 0;
        if (stepWithin(dir)) return;
        go(target + dir);
      },
      { passive: false },
    );

    // Typing, or activating a control, must never also move the page.
    function isTyping(target: EventTarget | null) {
      const el = target as HTMLElement | null;
      if (!el) return false;
      if (el.isContentEditable) return true;
      return ["INPUT", "TEXTAREA", "SELECT", "BUTTON", "A", "SUMMARY", "OPTION"].includes(
        el.tagName,
      );
    }

    window.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey || isTyping(e.target) || blocked()) return;
      let next: number | null = null;
      switch (e.key) {
        case "ArrowDown":
        case "ArrowRight":
        case "PageDown":
        case "Enter":
        case " ":
          next = target + 1;
          break;
        case "ArrowUp":
        case "ArrowLeft":
        case "PageUp":
          next = target - 1;
          break;
        case "Home":
          next = 0;
          break;
        case "End":
          next = sections.length - 1;
          break;
      }
      if (next === null) return;
      e.preventDefault();
      if (next === target + 1 && stepWithin(1)) return;
      if (next === target - 1 && stepWithin(-1)) return;
      go(next);
    });

    // Touch is left to the browser: `scroll-snap-stop: always` already lands a
    // swipe on exactly one section, and hijacking it would cost the native feel.
  }
</script>
