---
// Wheel navigation advances one section per glide; touch and keyboard remain native.
---

<script>
  const root = document.documentElement;
  const header = document.querySelector("header");
  const sections = [
    ...document.querySelectorAll<HTMLElement>("main > section[id], main > footer[id]"),
  ];
  const motion = matchMedia("(prefers-reduced-motion: reduce)");
  const headerHeight = () => header?.getBoundingClientRect().height ?? 64;
  const syncHeader = () => root.style.setProperty("--header-h", `${headerHeight()}px`);
  syncHeader();
  if (header) new ResizeObserver(syncHeader).observe(header);

  let lastInput = -Infinity;
  let nextAllowed = 0;
  let accumulated = 0;
  let direction = 0;
  window.addEventListener(
    "wheel",
    (event) => {
      if (
        !root.classList.contains("snap") ||
        !sections.length ||
        event.defaultPrevented ||
        event.ctrlKey ||
        root.style.overflow === "hidden" ||
        Math.abs(event.deltaX) >= Math.abs(event.deltaY)
      )
        return;
      const delta =
        event.deltaY * (event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? innerHeight : 1);
      const dir = Math.sign(delta);
      // Preserve independent scrolling inside menus and other scrollable panels.
      for (
        let el = event.target instanceof Element ? event.target : null;
        el && el !== document.body;
        el = el.parentElement
      ) {
        const style = getComputedStyle(el);
        if (
          /(auto|scroll)/.test(style.overflowY) &&
          el.scrollHeight > el.clientHeight + 1 &&
          (dir > 0 ? el.scrollTop + el.clientHeight < el.scrollHeight - 1 : el.scrollTop > 1)
        )
          return;
      }
      const now = performance.now();
      if (now - lastInput > 180 || dir !== direction) accumulated = 0;
      lastInput = now;
      direction = dir;
      const h = headerHeight();
      let index = 0;
      for (let i = 0; i < sections.length; i++) {
        if (sections[i].getBoundingClientRect().top <= h + 4) index = i;
      }
      const rect = sections[index].getBoundingClientRect();
      // Read all of an oversized slide before advancing, including at browser zoom.
      if (
        rect.height > innerHeight - h + 8 &&
        (dir > 0 ? rect.bottom > innerHeight + 2 : rect.top < h - 2)
      ) {
        accumulated = 0;
        return;
      }
      event.preventDefault();
      // This deadline always expires, even during a continuous wheel gesture.
      if (now < nextAllowed) return;
      accumulated += delta;
      if (Math.abs(accumulated) < 48) return;
      accumulated = 0;
      const next = Math.max(0, Math.min(sections.length - 1, index + dir));
      if (next === index) return;
      nextAllowed = now + (motion.matches ? 180 : 650);
      window.scrollTo({
        top: sections[next].getBoundingClientRect().top + scrollY - h,
        behavior: motion.matches ? "instant" : "smooth",
      });
    },
    { passive: false },
  );
</script>
