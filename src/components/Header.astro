---
import Wordmark from "@/components/Wordmark.astro";
import MobileMenu from "@/components/MobileMenu.astro";
import { AppearancePicker } from "@/components/islands/AppearancePicker";

const navLinks = [
  { label: "Features", href: "/#track" },
  { label: "Pricing", href: "/#pricing" },

  { label: "Guide", href: "/guide" },
];
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-background/70 backdrop-blur-xl">
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6 xl:max-w-7xl xl:px-10 2xl:max-w-[88rem]"
  >
    <Wordmark />
    <nav
      aria-label="Primary"
      class="hidden items-center gap-8 text-sm text-muted-foreground md:flex"
    >
      {
        navLinks.map((l) => (
          <a href={l.href} class="transition-colors hover:text-foreground">
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <AppearancePicker client:load />

      <MobileMenu links={navLinks} />
    </div>
  </div>
</header>
