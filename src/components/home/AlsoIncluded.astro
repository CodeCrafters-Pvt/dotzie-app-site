---
import GuideLink from "@/components/guide/GuideLink.astro";
import { SmsMockup } from "@/components/islands/FeatureMockups";
import { feature, cardsFor } from "@/data/features";

const slides = { sms: feature("sms") };
const alsoIncluded = cardsFor();
---

<!-- Auto-capture (SMS) + Also included -->
<section id="included" class="mx-auto max-w-5xl px-6 py-10 lg:py-14">
  <div class="reveal grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
    <div class="mx-auto w-full max-w-[19rem]">
      <SmsMockup client:visible />
    </div>
    <div>
      <p class="text-sm font-medium text-accent-500">
        {slides.sms.slide!.eyebrow}
      </p>
      <h3 class="mt-2 font-display text-2xl leading-tight tracking-tight sm:text-3xl">
        {slides.sms.slide!.headline}
      </h3>
      <p class="mt-3 max-w-md leading-relaxed text-muted-foreground">
        {slides.sms.slide!.blurb}{" "}
        <span class="text-foreground/70">(Android)</span>
      </p>
      <GuideLink feature={slides.sms} />
    </div>
  </div>

  <div class="reveal mt-12">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">
      Also included
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        alsoIncluded.map((item) => (
          <div class="rounded-2xl border border-border bg-card p-5 transition-colors hover:border-accent-500/40">
            <h3 class="text-base font-semibold">{item.card!.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.card!.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
