---
import { cardsFor } from "@/data/features";

const alsoIncluded = cardsFor();
---

<!-- The four extras. Shares the `#included` slide with SMS auto-capture. -->
<div>
  <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">
    Also included
  </p>
  <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:mt-6 lg:grid-cols-4 lg:gap-4">
    {
      alsoIncluded.map((item) => (
        <div class="rounded-2xl border border-border bg-card p-4 transition-colors hover:border-accent-500/40 lg:p-5">
          <h3 class="text-base font-semibold">{item.card!.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground lg:mt-2">
            {item.card!.desc}
          </p>
        </div>
      ))
    }
  </div>
</div>
