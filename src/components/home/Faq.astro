---
import { faqs } from "@/data/faq";
import { ArrowRight } from "lucide-react";
---

<section id="faq" class="mx-auto max-w-3xl px-6 py-6 lg:py-16">
  <p class="reveal text-sm font-medium text-accent-500">Frequently asked</p>
  <h2 class="reveal mt-2 font-display text-3xl tracking-tight sm:text-5xl lg:mt-3 lg:text-4xl">
    Questions, answered.
  </h2>

  <div class="reveal mt-5 divide-y divide-border border-t border-b border-border lg:mt-10">
    {
      faqs.map((f) => (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 text-left text-[0.95rem] font-medium transition-colors hover:text-accent-500 lg:py-4 lg:text-base [&::-webkit-details-marker]:hidden">
            {f.q}
            <svg
              class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <p class="pb-4 text-sm text-muted-foreground lg:text-base">{f.a}</p>
        </details>
      ))
    }
  </div>

  <div
    class="reveal mt-6 flex items-center justify-between gap-4 rounded-2xl border border-border bg-card p-4 transition-colors hover:border-accent-500/40 lg:mt-14 lg:p-6"
  >
    <div>
      <p class="font-semibold">Still curious?</p>
      <p class="text-sm text-muted-foreground">Read the user guide.</p>
    </div>
    <a
      href="/guide"
      class="group inline-flex items-center gap-2 text-sm font-medium text-accent-500 hover:text-accent-400"
    >
      Open the guide
      <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </a>
  </div>
</section>
