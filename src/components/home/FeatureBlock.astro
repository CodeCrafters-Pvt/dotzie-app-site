---
import GuideLink from "@/components/guide/GuideLink.astro";
import { feature } from "@/data/features";

interface Props {
  /** Feature id from `@/data/features`. */
  id: string;
  /** Put the mockup on the right from `md` up. */
  flip?: boolean;
  /** Small qualifier after the blurb, e.g. platform availability. */
  note?: string;
}

const { id, flip = false, note } = Astro.props;
const f = feature(id);
---

<div class="grid items-center gap-5 md:grid-cols-2 md:gap-10 lg:gap-12">
  <div
    class:list={[
      "mx-auto w-full max-w-[17rem] sm:max-w-[18rem] md:max-w-none lg:max-w-[19rem]",
      flip && "md:order-2",
    ]}
  >
    <slot />
  </div>
  <div class:list={[flip && "md:order-1"]}>
    <p class="text-sm font-medium text-accent-500">{f.slide!.eyebrow}</p>
    <h3 class="mt-2 font-display text-2xl leading-tight tracking-tight sm:text-3xl">
      {f.slide!.headline}
    </h3>
    <p class="mt-3 max-w-md text-sm leading-relaxed text-muted-foreground lg:text-base">
      {f.slide!.blurb}{note && <span class="text-foreground/70"> {note}</span>}
    </p>
    <GuideLink feature={f} />
  </div>
</div>
