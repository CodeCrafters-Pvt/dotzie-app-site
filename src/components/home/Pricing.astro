---
import { perksFor } from "@/data/features";
import { Sparkles } from "lucide-react";

const freePerks = perksFor("free");
const proPerks = perksFor("pro");
---

<section id="pricing" class="mx-auto max-w-6xl px-6 py-6 lg:py-16">
  <div class="reveal mx-auto max-w-2xl text-center">
    <p class="text-sm font-medium text-accent-500">Free &amp; Pro</p>
    <h2 class="mt-2 font-display text-3xl leading-tight tracking-tight sm:text-5xl lg:mt-3">
      Free to start. Pro when you want more.
    </h2>
    <p class="mt-3 text-sm text-muted-foreground lg:mt-4 lg:text-base">
      Try everything free first. Whenever you want the extras, you can switch to Pro right inside
      the app.
    </p>
  </div>

  <!-- Two tall cards stack into ~2.5 screens on a phone, so below `lg` the
       radios below act as a Free/Pro switch and only one card is shown.
       Pure CSS (see `.tier-deck` in styles.css) — no island needed. -->
  <div class="tier-deck reveal mt-6 lg:mt-10">
    <div role="radiogroup" aria-label="Plan" class="seg-switch" data-hide="lg">
      <input type="radio" name="tier" id="tier-free" class="sr-only" checked />
      <label for="tier-free">Free</label>
      <input type="radio" name="tier" id="tier-pro" class="sr-only" />
      <label for="tier-pro">Pro</label>
    </div>

    <div class="tier-cards grid gap-6 lg:grid-cols-2">
      <div class="tier-free rounded-3xl border border-border bg-card p-6 sm:p-8 lg:p-10">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Free</p>
        <h3 class="mt-3 font-display text-2xl tracking-tight sm:text-4xl lg:mt-4 lg:text-3xl">
          Everything you need to track, privately.
        </h3>
        <ul class="mt-5 space-y-3 lg:mt-8 lg:space-y-3.5">
          {
            freePerks.map((f) => (
              <li class="flex items-start gap-3 text-sm">
                <span aria-hidden class="mt-2 h-px w-4 shrink-0 bg-accent-500" />
                <span>{f.perk}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="tier-pro relative overflow-hidden rounded-3xl border border-transparent bg-promo p-6 text-promo-foreground shadow-xl sm:p-8 lg:p-10"
      >
        <div
          aria-hidden
          class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-accent-500/40 blur-3xl"
        >
        </div>
        <div class="relative flex items-center gap-3">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/60">Pro</p>
          <span
            class="rounded-full bg-accent-500/20 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-accent-300"
          >
            Coming soon
          </span>
        </div>
        <h3
          class="relative mt-3 font-display text-2xl tracking-tight text-white sm:text-4xl lg:mt-4 lg:text-3xl"
        >
          A little more insight, when you want it.
        </h3>
        <ul class="relative mt-5 space-y-3 lg:mt-8 lg:space-y-3.5">
          <li class="flex items-start gap-3 text-sm">
            <Sparkles className="mt-0.5 h-4 w-4 shrink-0 text-accent-400" aria-hidden />
            <span>Everything in Free</span>
          </li>
          {
            proPerks.map((f) => (
              <li class="flex items-start gap-3 text-sm">
                <Sparkles className="mt-0.5 h-4 w-4 shrink-0 text-accent-400" aria-hidden />
                <span>{f.perk}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <p class="reveal mt-5 text-center text-sm text-muted-foreground lg:mt-8">
    Upgrades are handled by the App Store and Google Play — never on this website. You'll see the
    price for your country there.
  </p>
</section>
