---
import { PhoneCarousel } from "@/components/islands/PhoneCarousel";
---

<!-- App screens showcase -->
<section id="screens" class="relative mx-auto max-w-6xl px-6 pt-4 lg:pt-8">
  <div class="reveal mx-auto max-w-2xl text-center">
    <p class="text-sm font-medium text-accent-500">A look inside</p>
    <h2 class="mt-2 font-display text-3xl tracking-tight sm:text-5xl lg:text-4xl">
      Six calm screens. One private app.
    </h2>
  </div>
  <PhoneCarousel client:visible />
</section>
