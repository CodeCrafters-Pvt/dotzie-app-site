---
import GuideLink from "@/components/guide/GuideLink.astro";
import { TrackMockup, SplitMockup } from "@/components/islands/FeatureMockups";
import { feature } from "@/data/features";

const slides = { track: feature("track"), split: feature("split") };
---

<!-- Features slide 1: Track + Split -->
<section id="track" class="mx-auto max-w-5xl px-6 py-10 lg:py-14">
  <div class="reveal space-y-10 lg:space-y-12">
    <!-- Track (image left) -->
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="mx-auto w-full max-w-[19rem]">
        <TrackMockup client:visible />
      </div>
      <div>
        <p class="text-sm font-medium text-accent-500">
          {slides.track.slide!.eyebrow}
        </p>
        <h3 class="mt-2 font-display text-2xl leading-tight tracking-tight sm:text-3xl">
          {slides.track.slide!.headline}
        </h3>
        <p class="mt-3 max-w-md leading-relaxed text-muted-foreground">
          {slides.track.slide!.blurb}
        </p>
        <GuideLink feature={slides.track} />
      </div>
    </div>

    <!-- Split (image right) -->
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="mx-auto w-full max-w-[19rem] lg:order-2">
        <SplitMockup client:visible />
      </div>
      <div class="lg:order-1">
        <p class="text-sm font-medium text-accent-500">
          {slides.split.slide!.eyebrow}
        </p>
        <h3 class="mt-2 font-display text-2xl leading-tight tracking-tight sm:text-3xl">
          {slides.split.slide!.headline}
        </h3>
        <p class="mt-3 max-w-md leading-relaxed text-muted-foreground">
          {slides.split.slide!.blurb}
        </p>
        <GuideLink feature={slides.split} />
      </div>
    </div>
  </div>
</section>
