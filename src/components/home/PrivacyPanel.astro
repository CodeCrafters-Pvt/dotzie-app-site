---
const privacyCards = [
  ["Stays on your phone", "Every expense you add is saved on your device, not on our servers."],
  [
    "Nothing to sign up for",
    "No account, no email, no password — you just open the app and start.",
  ],
  ["Only you can see it", "There's no cloud copy for anyone to peek at, leak, or hand over."],
];
---

<section
  id="privacy"
  class="relative overflow-hidden text-white"
  style="background: color-mix(in oklab, var(--accent-700) 22%, var(--deep));"
>
  <div aria-hidden class="pointer-events-none absolute inset-0">
    <div
      class="absolute inset-x-0 bottom-0 h-2/3"
      style="background: radial-gradient(65% 80% at 50% 100%, color-mix(in oklab, var(--accent-500) 45%, transparent), transparent 72%);"
    >
    </div>
  </div>
  <div class="relative mx-auto max-w-4xl px-6 py-6 text-center lg:py-12 xl:max-w-5xl xl:px-10">
    <p class="reveal text-xs font-semibold uppercase tracking-[0.2em] text-accent-400">
      Privacy by design
    </p>
    <h2
      class="reveal mt-3 font-display text-[1.75rem] leading-tight tracking-tight text-white sm:text-5xl lg:mt-4 lg:text-6xl"
    >
      Your data never leaves your device.{" "}
      <span
        class="animate-shimmer-text bg-clip-text italic text-transparent"
        style="background-image: linear-gradient(110deg, var(--accent-300), var(--accent-400), var(--accent-300), var(--accent-400), var(--accent-300));"
      >
        Not by policy — by design.
      </span>
    </h2>
    <p class="reveal mx-auto mt-3 max-w-2xl text-sm text-white/65 lg:mt-5 lg:text-lg">
      Every expense is stored and{" "}
      <strong class="font-semibold text-white">kept private right on your phone</strong>. There's no
      account to sign up for and nothing syncing to the cloud, so there's nothing to leak, sell, or
      hand over. The only person who can ever see your spending is you.
    </p>

    <dl
      class="reveal mx-auto mt-5 grid max-w-3xl gap-2.5 text-left sm:grid-cols-3 lg:mt-10 lg:gap-6"
    >
      {
        privacyCards.map(([k, v]) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-sm transition-all duration-500 hover:-translate-y-1 hover:border-accent-400/50 hover:bg-white/[0.07] lg:p-5">
            <dt class="font-display text-lg text-white lg:text-xl">{k}</dt>
            <dd class="mt-1 text-sm text-white/60 lg:mt-2">{v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
