---
import { DotzieMascot } from "@/components/islands/DotzieMascot";
import StoreDownloads from "@/components/StoreDownloads.astro";
const transactions = [
  ["Groceries", "Rs. 3,200"],
  ["Coffee", "Rs. 650"],
  ["Transport", "Rs. 450"],
];
---

<section id="top" class="companion-hero">
  <div class="companion-layout">
    <div class="companion-copy">
      <p class="companion-eyebrow">Your everyday money companion</p>
      <h1>Your spending.<br /><span>All in one place.</span></h1>
      <p class="companion-description">
        Track expenses, set budgets and split bills. Works offline, with no account needed.
      </p>
    </div>
    <div class="companion-scene">
      <div
        class="companion-phone"
        role="img"
        aria-label="Illustrative Dotzie spending overview: Rs. 24,850 spent this month, with groceries, coffee, and transport transactions."
      >
        <div class="companion-speaker" aria-hidden="true"></div>
        <div class="phone-heading"><span>This month</span><span aria-hidden="true">···</span></div>
        <p class="phone-total">Rs. 24,850</p><p class="phone-caption">Total spent</p>
        <div class="companion-bars" aria-hidden="true">
          {[35, 65, 48, 88, 58, 74, 45].map((height) => <span style={`height:${height}%`} />)}
        </div>
        <p class="phone-recent">Recent activity</p>
        {
          transactions.map(([label, amount]) => (
            <div class="companion-transaction">
              <>
                <span>{label}</span>
                <span>{amount}</span>
              </>
            </div>
          ))
        }
        <div class="phone-bottom" aria-hidden="true"></div>
      </div>
      <div class="companion-mascot"><DotzieMascot client:load /></div>
    </div>
    <div class="companion-downloads">
      <div id="download"><StoreDownloads id="hero" /></div>
      <p class="companion-note">Your spending records stay on your device.</p>
      <a class="companion-secondary hero-explore" href="#track"
        >Explore Dotzie <span aria-hidden="true">↓</span></a
      >
    </div>
  </div>
  <div class="companion-trust">
    <span>Works offline</span><span>No account needed</span><span>Private by design</span>
  </div>
</section>
