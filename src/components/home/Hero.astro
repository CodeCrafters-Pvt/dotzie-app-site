---
import { DownloadQR } from "@/components/islands/DownloadQR";
import { Receipt, Split, Banknote, Repeat, CalendarDays, Target } from "lucide-react";

const heroTxns = [
  { emoji: "🛒", label: "Groceries", sub: "Today · Market Co-op", amt: "-$42.00" },
  { emoji: "🚌", label: "Transport", sub: "Today · Metro", amt: "-$3.00" },
  { emoji: "☕", label: "Coffee", sub: "Yesterday · Ritual", amt: "-$4.50" },
];

/**
 * Feature chips that float around the hero phone. `pos` is the placement below
 * `lg`, `lgPos` the roomier one from `lg` up. A chip with no `pos` sits out the
 * small layout — six of them around a 196px handset is a wall, not a hint.
 * Both strings carry their own variant prefixes because Tailwind scans source
 * text: a prefix glued on at runtime would never reach the stylesheet.
 */
const heroChips = [
  {
    icon: Receipt,
    label: "Track expenses",
    short: "Expenses",
    pos: "-left-2 top-6",
    lgPos: "lg:left-0 lg:top-8",
    anim: "animate-float",
    delay: "-0.4s",
  },
  {
    icon: Split,
    label: "Split a budget",
    pos: null,
    lgPos: "lg:left-4 lg:top-[42%]",
    anim: "animate-float-slow",
    delay: "-2.6s",
  },
  {
    icon: Banknote,
    label: "Track salary",
    short: "Salary",
    pos: "-left-2 bottom-16",
    lgPos: "lg:left-0 lg:bottom-24",
    anim: "animate-float",
    delay: "-1.3s",
  },
  {
    icon: Repeat,
    label: "Recurring bills",
    short: "Bills",
    pos: "-right-2 top-24",
    lgPos: "lg:right-0 lg:top-20",
    anim: "animate-float-slow",
    delay: "-3.1s",
  },
  {
    icon: CalendarDays,
    label: "Event budgets",
    pos: null,
    lgPos: "lg:right-2 lg:top-[52%]",
    anim: "animate-float",
    delay: "-1.9s",
  },
  {
    icon: Target,
    label: "Savings goals",
    short: "Goals",
    pos: "-right-2 bottom-6",
    lgPos: "lg:right-0 lg:bottom-14",
    anim: "animate-float-slow",
    delay: "-2.2s",
  },
];
---

<section id="top" class="relative overflow-hidden">
  <div aria-hidden class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-24 right-0 h-[700px] w-[900px] translate-x-1/4 hero-glow"></div>
    <div
      class="absolute right-[6%] top-32 h-72 w-72 rounded-full bg-accent-400/40 opacity-60 blur-[80px] animate-blob"
    >
    </div>
    <div
      class="absolute right-[24%] top-72 h-72 w-72 rounded-full bg-accent-500/30 opacity-50 blur-[80px] animate-blob [animation-delay:-6s]"
    >
    </div>
  </div>

  {
    /* Below `lg` this is one column and the phone sits between the copy and the
      store buttons, so the device is on screen without pushing the call to
      action off it. From `lg` the copy stacks in column one and the phone
      spans both rows of column two. */
  }
  <div
    class="relative mx-auto flex max-w-6xl flex-col items-center gap-3 px-6 pt-2 pb-3 lg:grid lg:grid-cols-2 lg:grid-rows-[auto_auto] lg:items-center lg:gap-x-8 lg:gap-y-0 lg:pt-7 lg:pb-8 xl:max-w-7xl xl:gap-x-14 xl:px-10 2xl:max-w-[88rem]"
  >
    <div class="w-full text-left lg:col-start-1 lg:row-start-1 lg:self-end">
      <div class="flex animate-fade-up items-center gap-3">
        <span class="h-px w-10 bg-accent-500"></span>
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-500">
          Now in private beta
        </span>
      </div>

      {
        /* Sized so "Track every expense." holds one line on a handset — a third
          line costs the phone below it 40px it does not have. */
      }
      <h1
        class="mt-3 max-w-xl animate-fade-up font-display text-[2.05rem] leading-[1.05] tracking-tight max-[380px]:text-[1.8rem] [animation-delay:120ms] sm:text-6xl lg:mt-5 lg:text-[4.5rem]"
      >
        Track every expense.
        <br />
        <span class="italic text-accent-500">Trust</span> no server.
      </h1>

      <p
        class="mt-3 max-w-md animate-fade-up text-[0.95rem] leading-relaxed text-muted-foreground [animation-delay:240ms] sm:text-base lg:mt-5 lg:text-lg"
      >
        A beautifully quiet expense tracker for iOS and Android. Your money story stays sealed on
        your phone — encrypted, offline, and entirely yours.
      </p>
    </div>

    <div class="order-last w-full text-left lg:order-none lg:col-start-1 lg:row-start-2">
      <div
        id="download"
        class="flex animate-fade-up flex-row flex-wrap items-center gap-2.5 [animation-delay:360ms] lg:mt-7"
      >
        <a
          href="#"
          aria-label="Download Dotzie on the App Store"
          class="group flex flex-1 items-center justify-center gap-2 rounded-2xl bg-foreground px-3 py-2.5 text-background transition-all hover:-translate-y-0.5 hover:shadow-xl sm:w-auto sm:flex-none sm:justify-start sm:gap-3 sm:px-5 sm:py-3"
        >
          <svg aria-hidden viewBox="0 0 24 24" class="h-5 w-5 fill-current sm:h-6 sm:w-6">
            <path
              d="M16.365 1.43c0 1.14-.47 2.24-1.24 3.03-.82.85-2.13 1.5-3.22 1.42-.13-1.09.42-2.24 1.16-3 .82-.85 2.22-1.5 3.3-1.45zM20.5 17.02c-.55 1.27-.81 1.84-1.52 2.96-.99 1.55-2.38 3.48-4.1 3.5-1.54.01-1.94-1-4.03-1-2.09.01-2.53 1.02-4.08 1.01-1.72-.02-3.04-1.76-4.03-3.3C.06 16.4-.02 11.1 2.24 8.3c1.47-1.82 3.55-2.88 5.51-2.88 2.02 0 3.28 1.11 4.95 1.11 1.62 0 2.61-1.11 4.94-1.11 1.76 0 3.62.96 4.95 2.62-4.35 2.38-3.64 8.58-2.09 9.98z"
            ></path>
          </svg>
          <span class="text-left leading-tight">
            <span class="block text-[10px] uppercase tracking-widest opacity-70 max-[380px]:hidden"
              >Download on the</span
            >
            <span class="block text-sm font-semibold sm:text-base">App Store</span>
          </span>
        </a>
        <a
          href="#"
          aria-label="Get Dotzie on Google Play"
          class="group flex flex-1 items-center justify-center gap-2 rounded-2xl border border-border bg-card px-3 py-2.5 transition-all hover:-translate-y-0.5 hover:bg-elevated hover:shadow-xl sm:w-auto sm:flex-none sm:justify-start sm:gap-3 sm:px-5 sm:py-3"
        >
          <svg aria-hidden viewBox="0 0 24 24" class="h-5 w-5 sm:h-6 sm:w-6">
            <path
              d="M3.6 2.2C3.2 2.5 3 3 3 3.6v16.8c0 .6.2 1.1.6 1.4l9.8-9.8L3.6 2.2z"
              fill="var(--accent-500)"></path>
            <path
              d="M17.6 8.4L14.4 6.6 4 1c-.2-.1-.4-.1-.6-.1l10 10L17.6 8.4z"
              fill="var(--accent-400)"></path>
            <path
              d="M21 10.7l-3.4-1.9-3.2 3.2 3.2 3.2 3.4-1.9c1-.5 1-2.1 0-2.6z"
              fill="var(--accent-700)"></path>
            <path
              d="M3.4 22.9c.2 0 .4 0 .6-.1l10.4-5.7 3.2-1.8-3.8-3.8L3.4 22.9z"
              fill="var(--accent-600)"></path>
          </svg>
          <span class="text-left leading-tight">
            <span class="block text-[10px] uppercase tracking-widest text-muted-foreground max-[380px]:hidden"
              >Get it on</span
            >
            <span class="block text-sm font-semibold sm:text-base">Google Play</span>
          </span>
        </a>
      </div>

      {/* Pointless on a phone — you'd be scanning the screen you're holding. */}
      <div class="hidden lg:block">
        <DownloadQR client:visible />
      </div>

      <p class="mt-3 animate-fade-up text-xs text-muted-foreground [animation-delay:520ms] lg:mt-5">
        Free to download. No account. No trackers. No ads.
      </p>
    </div>

    <div
      class="relative w-full max-w-[22rem] animate-fade-up [animation-delay:300ms] sm:max-w-none lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center"
    >
      <div
        aria-hidden
        class="pointer-events-none absolute -inset-6 -z-10 rounded-[3rem] bg-accent-500/20 blur-3xl"
      >
      </div>

      {
        heroChips.map((c) => {
          const Icon = c.icon;
          return (
            <div
              class={`absolute z-20 items-center gap-1.5 rounded-xl border border-border bg-card/90 px-2 py-1.5 shadow-lg backdrop-blur lg:gap-2 lg:rounded-2xl lg:px-3 lg:py-2 ${c.pos ? "flex" : "hidden"} lg:flex ${c.pos ?? ""} ${c.lgPos} ${c.anim}`}
              style={`animation-delay:${c.delay}`}
            >
              <span class="flex h-6 w-6 items-center justify-center rounded-lg bg-accent-500/10 lg:h-7 lg:w-7">
                <Icon className="h-3.5 w-3.5 text-accent-500 lg:h-4 lg:w-4" aria-hidden />
              </span>
              <span class="whitespace-nowrap text-[0.65rem] font-medium text-foreground lg:text-xs">
                <span class="lg:hidden">{c.short ?? c.label}</span>
                <span class="hidden lg:inline">{c.label}</span>
              </span>
            </div>
          );
        })
      }

      {
        /* 196px is the floor at which the screen below still renders its
          numbers whole — the type inside steps down with it. */
      }
      <div
        class="animate-float relative z-10 mx-auto h-[386px] w-[196px] max-[380px]:h-[356px] max-[380px]:w-[186px] rounded-[2.1rem] border border-border bg-device-frame p-2 shadow-2xl ring-1 ring-white/5 sm:h-[500px] sm:w-[250px] sm:rounded-[2.6rem] sm:p-2.5"
      >
        <div
          class="absolute left-1/2 top-2 z-10 h-5 w-20 -translate-x-1/2 rounded-full bg-black/90 sm:top-2.5 sm:h-6 sm:w-24"
        >
        </div>
        <div
          class="relative h-full w-full overflow-hidden rounded-[1.7rem] bg-device-screen text-device-foreground sm:rounded-[2.1rem]"
        >
          <div
            class="flex items-center justify-between px-4 pt-2.5 text-[10px] font-medium text-white/80 sm:px-5 sm:pt-3"
          >
            <span>9:41</span>
            <span class="flex items-center gap-1">
              <span class="inline-block h-2 w-3 rounded-sm bg-white/70"></span>
              <span class="inline-block h-2 w-3 rounded-sm bg-white/70"></span>
            </span>
          </div>

          <div class="px-4 sm:px-5">
            <p class="mt-5 text-[9px] uppercase tracking-widest text-white/40 sm:mt-7 sm:text-[10px]">
              Balance this month
            </p>
            <p class="mt-1 font-display text-[2.05rem] leading-none sm:text-[2.75rem]">
              $1,240<span class="text-accent-400">.50</span>
            </p>
            <p
              class="mt-1.5 flex items-center gap-1 text-[10px] font-medium text-accent-300 sm:mt-2 sm:text-[11px]"
            >
              <span aria-hidden>▼</span> 12% vs last month
            </p>

            <div class="mt-5 space-y-1.5 sm:mt-7 sm:space-y-2">
              {
                heroTxns.map((t) => (
                  <div class="flex items-center gap-2 rounded-xl bg-device-surface p-2 sm:gap-3 sm:p-2.5">
                    <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-white/5 text-[13px] sm:h-8 sm:w-8 sm:text-[15px]">
                      {t.emoji}
                    </span>
                    <div class="min-w-0 flex-1">
                      <p class="text-[11px] font-medium sm:text-[12px]">{t.label}</p>
                      <p class="truncate text-[9px] text-white/50 sm:text-[10px]">{t.sub}</p>
                    </div>
                    <p class="text-[11px] text-rose-300 sm:text-[12px]">{t.amt}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
