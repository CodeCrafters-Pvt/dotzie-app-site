---
interface Props {
  /** Slide anchor id. */
  id: string;
  /** Labels for the two panes, used by the small-screen switcher. */
  tabs: [string, string];
}

const { id, tabs } = Astro.props;
const group = `${id}-tab`;
---

{/* Two panes on one slide. From `md` (iPad Mini) up they stack and are both
    visible, as on desktop. Below that they'd be three screens tall, so a
    segmented switcher shows one at a time — pure CSS via `:has()`, see
    `.tab-panes` in styles.css. */}
<section id={id} class="mx-auto max-w-5xl px-6 py-6 md:py-10 lg:py-14">
  <div class="tabbed reveal">
    <div role="radiogroup" aria-label={`${tabs[0]} or ${tabs[1]}`} class="seg-switch" data-hide="md">
      {
        tabs.map((label, i) => (
          <Fragment>
            <input
              type="radio"
              name={group}
              id={`${group}-${i}`}
              data-tab={i}
              class="sr-only"
              checked={i === 0}
            />
            <label for={`${group}-${i}`}>{label}</label>
          </Fragment>
        ))
      }
    </div>

    <div class="tab-panes space-y-6 md:space-y-10 lg:space-y-12">
      <div data-pane="0"><slot name="one" /></div>
      <div data-pane="1"><slot name="two" /></div>
    </div>
  </div>
</section>
