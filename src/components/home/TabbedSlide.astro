---
interface Props {
  /** Section anchor id. */
  id: string;
  /** Labels for the two panes, used by the small-screen switcher. */
  tabs: [string, string];
}

const { id, tabs } = Astro.props;
const group = `${id}-tab`;
---

{
  /* Two panes in one section. From `md` (iPad Mini) up they stack and are
    both visible, as on desktop. Below that they'd be three screens tall, so a
    segmented switcher shows one at a time — pure CSS via `:has()`, see
    `.tab-panes` in styles.css. */
}
<section id={id} class="px-6 py-5 md:py-6 xl:px-10">
  <div class="section-container tabbed reveal mx-auto max-w-5xl xl:max-w-6xl 2xl:max-w-7xl">
    <div
      role="radiogroup"
      aria-label={`${tabs[0]} or ${tabs[1]}`}
      class="seg-switch"
      data-hide="md"
    >
      {
        tabs.map((label, i) => (
          <Fragment>
            <input
              type="radio"
              name={group}
              id={`${group}-${i}`}
              data-tab={i}
              class="sr-only"
              checked={i === 0}
            />
            <label for={`${group}-${i}`}>{label}</label>
          </Fragment>
        ))
      }
    </div>

    <div class="tab-panes space-y-5">
      <div data-pane="0"><slot name="one" /></div>
      <div data-pane="1"><slot name="two" /></div>
    </div>
  </div>
</section>
