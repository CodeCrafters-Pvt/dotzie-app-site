---
/**
 * Presentation-deck engine for the homepage.
 *
 * Turns `main.deck-stage > section` (plus the footer) into one-at-a-time
 * slides. The page itself never scrolls — an index drives which slide is
 * visible, moved by keys, wheel, swipe, or the nav rail (SectionNav).
 *
 * Each slide is scaled down to fit one screen; slides that would need to
 * shrink past MIN_SCALE keep their own inner scroll instead of becoming
 * unreadable. Styles live in `styles.css` under `html.deck`.
 */
---

<script>
  /** Never shrink a slide past this — below it, the slide scrolls instead. */
  const MIN_SCALE = 0.5;
  /** Matches the slide transition in styles.css. */
  const TRANSITION_MS = 420;

  const root = document.documentElement;
  const stage = document.querySelector<HTMLElement>(".deck-stage");

  if (root.classList.contains("deck") && stage) init(stage);

  function init(stage: HTMLElement) {
    const all = Array.from(stage.children).filter(
      (el): el is HTMLElement => el instanceof HTMLElement && el.matches("section, footer"),
    );
    if (all.length < 2) return;

    // Everything inside a slide moves into a `.deck-fit` wrapper, and that is
    // what scale-to-fit shrinks. Scaling the <section> itself would shrink its
    // background too, so full-bleed panels (the footer, the privacy panel)
    // would stop reaching the edges of the screen.
    all.forEach((s, i) => {
      if (!s.id) s.id = `slide-${i}`;
      s.classList.add("deck-slide");
      const box = document.createElement("div");
      box.className = "deck-fit";
      while (s.firstChild) box.appendChild(s.firstChild);
      s.appendChild(box);
    });

    const fitBox = (s: HTMLElement) => s.firstElementChild as HTMLElement;

    // Slides can be per-breakpoint (`lg:hidden` and friends), so the running
    // set is whatever is currently displayed — recollected on every resize.
    let slides: HTMLElement[] = [];
    let ids: string[] = [];
    let index = 0;
    let locked = false;

    function collect() {
      const currentId = slides[index]?.id;
      slides = all.filter((s) => getComputedStyle(s).display !== "none");
      ids = slides.map((s) => s.id);
      const found = currentId ? ids.indexOf(currentId) : -1;
      index = found >= 0 ? found : Math.min(index, slides.length - 1);
    }

    /* ---- scale-to-fit ------------------------------------------------- */

    // Desktop only. On phones, shrinking a stacked layout just makes it
    // unreadable — those slides are authored to fit instead, and anything
    // still too tall gets its own scroll (see `.deck-overflow`).
    const wide = window.matchMedia("(min-width: 1024px)");

    // `.deck-fit` sits in a centred flex column, so its height is its natural
    // content height even when that overflows — and `offsetHeight` ignores the
    // transform, so it can be measured while scaled. All reads happen before
    // any write so the browser only reflows once.
    function fit() {
      if (!stage.clientHeight) return;

      const readings = slides.map((s) => {
        const cs = getComputedStyle(s);
        const avail =
          s.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
        return { s, avail, natural: fitBox(s).offsetHeight };
      });

      readings.forEach(({ s, avail, natural }) => {
        const raw = natural > 0 && avail > 0 ? avail / natural : 1;
        const scale = wide.matches ? Math.min(1, Math.max(MIN_SCALE, raw)) : 1;
        s.style.setProperty("--deck-scale", scale.toFixed(4));
        // Overflowing means "give this slide its own scroll" — on desktop only
        // once scaling has given up, on mobile as soon as it doesn't fit.
        s.classList.toggle("deck-overflow", raw < (wide.matches ? MIN_SCALE : 1));
      });
    }

    let fitQueued = false;
    function queueFit() {
      if (fitQueued) return;
      fitQueued = true;
      requestAnimationFrame(() => {
        fitQueued = false;
        fit();
      });
    }

    // A resize can change which slides exist, so recollect before refitting.
    function refresh() {
      collect();
      fit();
      render(true);
    }

    window.addEventListener("resize", () => {
      collect();
      queueFit();
    });
    wide.addEventListener("change", refresh);
    // Islands hydrate and webfonts land after first paint — both change how
    // tall a slide is, so re-fit whenever slide content resizes.
    if ("ResizeObserver" in window) {
      const ro = new ResizeObserver(queueFit);
      all.forEach((s) => Array.from(s.children).forEach((c) => ro.observe(c)));
    }
    document.fonts?.ready.then(queueFit);

    /* ---- slide state -------------------------------------------------- */

    function render(initial = false) {
      slides.forEach((s, i) => {
        const active = i === index;
        s.classList.toggle("is-active", active);
        s.setAttribute("aria-hidden", active ? "false" : "true");
        s.inert = !active;
        if (active) {
          s.scrollTop = 0;
          // Base.astro's scroll-triggered reveals can't work here — every
          // slide overlaps the viewport — so play them on arrival instead.
          s.querySelectorAll(".reveal").forEach((el) => el.classList.add("in"));
        }
      });

      if (!initial) {
        const active = slides[index];
        active.setAttribute("tabindex", "-1");
        active.focus({ preventScroll: true });
        history.replaceState(null, "", `#${ids[index]}`);
      }

      window.dispatchEvent(
        new CustomEvent("deck:change", {
          detail: { index, count: slides.length, id: ids[index] },
        }),
      );
    }

    function go(i: number, opts: { wrap?: boolean } = {}) {
      const last = slides.length - 1;
      const target = opts.wrap ? ((i % slides.length) + slides.length) % slides.length : i;
      const next = Math.max(0, Math.min(last, target));
      if (next === index || locked) return;

      stage.dataset.dir = next > index ? "forward" : "back";
      index = next;
      locked = true;
      window.setTimeout(() => {
        locked = false;
      }, TRANSITION_MS);
      render();
    }

    /* ---- input -------------------------------------------------------- */

    // Typing, or activating a control, must never also flip the slide.
    function isTyping(target: EventTarget | null) {
      const el = target as HTMLElement | null;
      if (!el) return false;
      if (el.isContentEditable) return true;
      return ["INPUT", "TEXTAREA", "SELECT", "BUTTON", "A", "SUMMARY", "OPTION"].includes(
        el.tagName,
      );
    }

    window.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (isTyping(e.target)) return;

      switch (e.key) {
        case "Enter":
        case " ":
        case "ArrowRight":
        case "ArrowDown":
        case "PageDown":
          e.preventDefault();
          go(index + 1);
          break;
        case "ArrowLeft":
        case "ArrowUp":
        case "PageUp":
          e.preventDefault();
          go(index - 1);
          break;
        case "Home":
          e.preventDefault();
          go(0);
          break;
        case "End":
          e.preventDefault();
          go(slides.length - 1);
          break;
      }
    });

    /** True while a scrollable slide still has room to scroll that way. */
    function canScrollWithin(delta: number) {
      const s = slides[index];
      if (!s.classList.contains("deck-overflow")) return false;
      const room = s.scrollHeight - s.clientHeight;
      if (room <= 1) return false;
      return delta > 0 ? s.scrollTop < room - 1 : s.scrollTop > 1;
    }

    let wheelCooling = false;
    stage.addEventListener(
      "wheel",
      (e) => {
        const delta = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        if (canScrollWithin(delta)) return;
        e.preventDefault();
        if (wheelCooling || Math.abs(delta) < 8) return;
        wheelCooling = true;
        window.setTimeout(() => {
          wheelCooling = false;
        }, TRANSITION_MS + 120);
        go(index + (delta > 0 ? 1 : -1));
      },
      { passive: false },
    );

    let touchX = 0;
    let touchY = 0;
    stage.addEventListener(
      "touchstart",
      (e) => {
        touchX = e.touches[0].clientX;
        touchY = e.touches[0].clientY;
      },
      { passive: true },
    );
    stage.addEventListener(
      "touchend",
      (e) => {
        const dx = touchX - e.changedTouches[0].clientX;
        const dy = touchY - e.changedTouches[0].clientY;
        const delta = Math.abs(dy) > Math.abs(dx) ? dy : dx;
        if (Math.abs(delta) < 45 || canScrollWithin(delta)) return;
        go(index + (delta > 0 ? 1 : -1));
      },
      { passive: true },
    );

    /* ---- hash links --------------------------------------------------- */

    /** Slide index owning `#id` — the target may be nested inside a slide. */
    function indexForHash(hash: string) {
      const id = hash.replace(/^#/, "");
      if (!id) return -1;
      const target = document.getElementById(id);
      if (!target) return -1;
      const slide = target.closest("section, footer") as HTMLElement | null;
      return slide ? slides.indexOf(slide) : -1;
    }

    // In-page anchors jump the deck rather than scrolling to nothing.
    document.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement | null)?.closest("a");
      if (!link) return;
      const href = link.getAttribute("href") ?? "";
      if (!href.startsWith("#") && !href.startsWith("/#")) return;
      const i = indexForHash(href.slice(href.indexOf("#")));
      if (i < 0) return;
      e.preventDefault();
      go(i);
    });

    window.addEventListener("hashchange", () => {
      const i = indexForHash(location.hash);
      if (i >= 0) go(i);
    });

    collect();
    const start = indexForHash(location.hash);
    if (start > 0) index = start;
    fit();
    render(true);
    root.classList.add("deck-ready");

    const api: DotzieDeck = {
      get index() {
        return index;
      },
      get count() {
        return slides.length;
      },
      get ids() {
        return [...ids];
      },
      go,
      next: () => go(index + 1),
      prev: () => go(index - 1),
    };
    window.dotzieDeck = api;
    window.dispatchEvent(new CustomEvent("deck:ready"));
  }
</script>
