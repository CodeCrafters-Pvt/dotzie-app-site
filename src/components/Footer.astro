---
import Wordmark from "@/components/Wordmark.astro";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Company",
    links: [
      ["Features", "/#track"],
      ["Guide", "/guide"],
      ["Blog", "/blog"],
      ["Privacy", "/#privacy"],
      ["FAQ", "/#faq"],
    ],
  },
  {
    title: "Legal",
    links: [
      ["Privacy Policy", "/privacy"],
      ["Terms", "/terms"],
    ],
  },
];

// Brand glyphs (simple-icons paths) — lucide doesn't ship TikTok/Reddit/WhatsApp.
