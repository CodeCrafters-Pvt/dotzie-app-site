---

<footer id="site-footer" class="border-t border-border bg-card">
  <div class="mx-auto max-w-6xl px-6 py-6 lg:py-20">
    <div class="text-center">
      <p class="text-sm font-medium text-accent-500">Get the app</p>
      <h2
        class="mt-2 font-display text-3xl leading-tight tracking-tight sm:text-4xl lg:mt-3 lg:text-5xl"
      >
        Your money, kept close.
      </h2>
      <p class="mt-2 text-sm text-muted-foreground lg:mt-4 lg:text-base">
        Free to download. No account. No trackers. No ads.
      </p>

      <div
        class="mx-auto mt-5 flex max-w-sm flex-col items-stretch gap-3 sm:max-w-none sm:flex-row sm:flex-wrap sm:items-center sm:justify-center lg:mt-8"
      >
        <a
          href="#"
          aria-label="Download Dotzie on the App Store"
          class="group flex w-full items-center justify-center gap-3 rounded-2xl bg-foreground px-5 py-3 text-background transition-all hover:-translate-y-0.5 hover:shadow-xl sm:inline-flex sm:w-auto"
        >
          <svg aria-hidden viewBox="0 0 24 24" class="h-6 w-6 fill-current">
            <path
              d="M16.365 1.43c0 1.14-.47 2.24-1.24 3.03-.82.85-2.13 1.5-3.22 1.42-.13-1.09.42-2.24 1.16-3 .82-.85 2.22-1.5 3.3-1.45zM20.5 17.02c-.55 1.27-.81 1.84-1.52 2.96-.99 1.55-2.38 3.48-4.1 3.5-1.54.01-1.94-1-4.03-1-2.09.01-2.53 1.02-4.08 1.01-1.72-.02-3.04-1.76-4.03-3.3C.06 16.4-.02 11.1 2.24 8.3c1.47-1.82 3.55-2.88 5.51-2.88 2.02 0 3.28 1.11 4.95 1.11 1.62 0 2.61-1.11 4.94-1.11 1.76 0 3.62.96 4.95 2.62-4.35 2.38-3.64 8.58-2.09 9.98z"
            ></path>
          </svg>
          <span class="text-left leading-tight">
            <span class="block text-[10px] uppercase tracking-widest opacity-70"
              >Download on the</span
            >
            <span class="block text-base font-semibold">App Store</span>
          </span>
        </a>
        <a
          href="#"
          aria-label="Get Dotzie on Google Play"
          class="group flex w-full items-center justify-center gap-3 rounded-2xl border border-border bg-background px-5 py-3 transition-all hover:-translate-y-0.5 hover:bg-elevated hover:shadow-xl sm:inline-flex sm:w-auto"
        >
          <svg aria-hidden viewBox="0 0 24 24" class="h-6 w-6">
            <path
              d="M3.6 2.2C3.2 2.5 3 3 3 3.6v16.8c0 .6.2 1.1.6 1.4l9.8-9.8L3.6 2.2z"
              fill="var(--accent-500)"></path>
            <path
              d="M17.6 8.4L14.4 6.6 4 1c-.2-.1-.4-.1-.6-.1l10 10L17.6 8.4z"
              fill="var(--accent-400)"></path>
            <path
              d="M21 10.7l-3.4-1.9-3.2 3.2 3.2 3.2 3.4-1.9c1-.5 1-2.1 0-2.6z"
              fill="var(--accent-700)"></path>
            <path
              d="M3.4 22.9c.2 0 .4 0 .6-.1l10.4-5.7 3.2-1.8-3.8-3.8L3.4 22.9z"
              fill="var(--accent-600)"></path>
          </svg>
          <span class="text-left leading-tight">
            <span class="block text-[10px] uppercase tracking-widest text-muted-foreground"
              >Get it on</span
            >
            <span class="block text-base font-semibold">Google Play</span>
          </span>
        </a>
      </div>
    </div>

    <div
      class="mt-6 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-border pt-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-10 lg:pt-12"
    >
      <!-- The blurb is desktop-only; on a phone it repeats the hero one slide over. -->
      <div class="col-span-2 lg:col-span-1">
        <Wordmark />
        <p class="mt-3 hidden max-w-xs text-sm text-muted-foreground lg:block">
          An offline expense tracker for people who like their money — and their data — kept close.
        </p>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="text-sm font-semibold">{col.title}</p>
            <ul class="mt-2 space-y-1.5 text-sm text-muted-foreground lg:mt-4 lg:space-y-2">
              {col.links.map(([label, href]) => (
                <li>
                  <a href={href} class="transition-colors hover:text-foreground">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <p class="text-sm font-semibold">Contact</p>
        <ul class="mt-2 space-y-1.5 text-sm text-muted-foreground lg:mt-4 lg:space-y-2">
          <li>
            <a href="mailto:hello@dotzie.app" class="hover:text-foreground">hello@dotzie.app</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-6 flex flex-col items-center gap-3 lg:mt-12 lg:gap-4">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Follow</p>
      <div class="flex flex-wrap justify-center gap-2" aria-label="Social links">
        {
          socials.map(({ label, href, path }) => (
            <a
              href={href}
              target="_blank"
              rel="noreferrer noopener"
              aria-label={label}
              title={label}
              class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-muted-foreground transition-all hover:-translate-y-0.5 hover:border-accent-500/60 hover:text-foreground"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden>
                <path d={path} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-border">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-1 px-6 py-4 text-xs text-muted-foreground sm:flex-row sm:items-center lg:gap-2 lg:py-6"
    >
      <p>© {year} Dotzie. All rights reserved.</p>
      <p>Made offline, on purpose.</p>
    </div>
  </div>
</footer>
