---
import "../styles.css";
import { SITE_NAME, SITE_TAGLINE, SITE_DESC } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  /** Canonical path, e.g. "/guide". Defaults to the current page path. */
  path?: string;
  image?: string;
  /** Extra JSON-LD blocks for this page (Organization is always included). */
  jsonLd?: Record<string, unknown>[];
  ogType?: string;
  /** Presentation mode: full-screen scroll-snap slides (desktop only). */
  deck?: boolean;
}

const {
  title = `${SITE_NAME} — ${SITE_TAGLINE}`,
  description = SITE_DESC,
  path = Astro.url.pathname,
  image = "/og.png",
  jsonLd = [],
  ogType = "website",
  deck = false,
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: Astro.site?.href,
  description: SITE_DESC,
};

const blocks = [organizationJsonLd, ...jsonLd];

// Private until launch: keep every page out of search results unless
// PUBLIC_SITE_LIVE is explicitly "true" in the deploy environment.
const isLive = import.meta.env.PUBLIC_SITE_LIVE === "true";
---

<!doctype html>
<html lang="en" class={deck ? "deck" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="canonical" href={canonical} />
    {!isLive && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" content="#07070A" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Manrope:wght@400;500;600;700;800&display=swap"
    />

    <!-- No-flash: apply theme + accent before first paint -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("dotzee-theme");
          var m = window.matchMedia("(prefers-color-scheme: dark)").matches;
          var d = s ? s === "dark" : m;
          if (d) document.documentElement.classList.add("dark");
          var a = localStorage.getItem("dotzie-accent");
          if (a) document.documentElement.setAttribute("data-accent", a);
        } catch (e) {}
      })();
    </script>

    {blocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <slot />

    <script>
      // Reveal-on-scroll for any element with the `.reveal` class. Deck pages
      // opt out: every slide overlaps the viewport, so they'd all reveal at
      // once — Deck.astro reveals each slide as it becomes active instead.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      if (!document.documentElement.classList.contains("deck")) {
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
