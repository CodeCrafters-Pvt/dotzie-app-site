---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getGuidePages, groupBySection, guideIcon, guideHref } from "@/lib/guide";
import { ArrowRight } from "lucide-react";

const TITLE = "User Guide — Dotzie";
const DESC =
  "Learn Dotzie feature by feature: adding transactions, scheduled payments, budgets, events, IOUs, insights and encrypted backups. Everything stays on your device.";

const pages = await getGuidePages();
const groups = groupBySection(pages);
const start = pages.filter((p) => p.data.section === "Start here");

const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Dotzie user guide",
  itemListElement: pages.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: p.data.title,
    url: new URL(guideHref(p), Astro.site).href,
  })),
};
---

<Base title={TITLE} description={DESC} path="/guide" jsonLd={[howToJsonLd]}>
  <div class="min-h-screen bg-background text-foreground">
    <Header />

    <main class="relative overflow-hidden">
      <div aria-hidden class="pointer-events-none absolute inset-0 -z-10">
        <div
          class="absolute -top-24 left-1/2 h-[500px] w-[800px] -translate-x-1/2 hero-glow opacity-70"
        >
        </div>
      </div>

      <section class="mx-auto max-w-3xl px-6 pt-20 pb-12 text-center">
        <p class="text-sm font-medium text-accent-500">User guide</p>
        <h1 class="mt-3 font-display text-5xl leading-tight tracking-tight sm:text-6xl">
          How Dotzie works,{" "}
          <span
            class="italic text-transparent bg-clip-text"
            style="background-image: linear-gradient(110deg, var(--accent-400), var(--accent-600), var(--accent-300));"
          >
            feature by feature.
          </span>
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-muted-foreground">
          Every screen in the app, explained. Start at the beginning or jump straight to the thing
          you're stuck on — nothing here leaves your phone.
        </p>
      </section>

      <!-- Start here -->
      <section class="mx-auto max-w-5xl px-6 pb-16">
        <div class="grid gap-4 sm:grid-cols-2">
          {
            start.map((p) => {
              const Icon = guideIcon(p.data.icon);
              return (
                <a
                  href={guideHref(p)}
                  class="group rounded-2xl border border-border bg-card p-6 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-500/50 hover:bg-elevated"
                >
                  <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border bg-elevated">
                    <Icon className="h-4 w-4 text-accent-500" aria-hidden />
                  </span>
                  <h2 class="mt-4 font-display text-2xl tracking-tight">{p.data.title}</h2>
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                    {p.data.description}
                  </p>
                  <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-accent-500">
                    Read it
                    <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
                  </span>
                </a>
              );
            })
          }
        </div>
      </section>

      <!-- Everything else, by section -->
      <section class="mx-auto max-w-5xl px-6 pb-20">
        {
          groups
            .filter((g) => g.section !== "Start here")
            .map((g) => (
              <div class="mb-12 last:mb-0">
                <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">
                  {g.section}
                </h2>
                <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {g.pages.map((p) => {
                    const Icon = guideIcon(p.data.icon);
                    return (
                      <a
                        href={guideHref(p)}
                        class="group flex flex-col rounded-2xl border border-border bg-card p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-500/50 hover:bg-elevated"
                      >
                        <span class="flex items-center gap-2.5">
                          <Icon className="h-4 w-4 shrink-0 text-accent-500" aria-hidden />
                          <span class="text-base font-semibold leading-tight">{p.data.title}</span>
                        </span>
                        <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">
                          {p.data.description}
                        </p>
                      </a>
                    );
                  })}
                </div>
              </div>
            ))
        }
      </section>

      <section class="mx-auto max-w-5xl px-6 pb-24">
        <div
          class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-border bg-card p-6 transition-colors hover:border-accent-500/40"
        >
          <div>
            <p class="font-semibold">Ready to try Dotzie?</p>
            <p class="text-sm text-muted-foreground">Free to download. No account required.</p>
          </div>
          <a
            href="/#download"
            class="group inline-flex items-center gap-2 text-sm font-medium text-accent-500 hover:text-accent-400"
          >
            Get the app
            <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
