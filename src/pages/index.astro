---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import GuideLink from "@/components/GuideLink.astro";
import { PhoneCarousel } from "@/components/islands/PhoneCarousel";
import { DownloadQR } from "@/components/islands/DownloadQR";
import { SectionNav } from "@/components/islands/SectionNav";
import {
  TrackMockup,
  SplitMockup,
  PlanMockup,
  EventMockup,
  SmsMockup,
} from "@/components/islands/FeatureMockups";
import { faqs } from "@/data/faq";
import { feature, featureGuideHref, cardsFor, perksFor } from "@/data/features";
import {
  Sparkles,
  ArrowRight,
  Receipt,
  Split,
  Banknote,
  Repeat,
  CalendarDays,
  Target,
} from "lucide-react";

const APP_NAME = "Dotzie";
const APP_TAGLINE = "Offline-first, privacy-first expense tracker";
const APP_DESC =
  "Dotzie is an offline-first expense tracker. All your financial data stays encrypted on your device — no cloud, no server, no accounts.";

const heroTxns = [
  { emoji: "🛒", label: "Groceries", sub: "Today · Market Co-op", amt: "-$42.00" },
  { emoji: "🚌", label: "Transport", sub: "Today · Metro", amt: "-$3.00" },
  { emoji: "☕", label: "Coffee", sub: "Yesterday · Ritual", amt: "-$4.50" },
];

// Feature chips that float beside the hero phone.
const heroChips = [
  {
    icon: Receipt,
    label: "Track expenses",
    pos: "left-0 top-8",
    anim: "animate-float",
    delay: "-0.4s",
  },
  {
    icon: Split,
    label: "Split a budget",
    pos: "left-4 top-[42%]",
    anim: "animate-float-slow",
    delay: "-2.6s",
  },
  {
    icon: Banknote,
    label: "Track salary",
    pos: "left-0 bottom-24",
    anim: "animate-float",
    delay: "-1.3s",
  },
  {
    icon: Repeat,
    label: "Recurring bills",
    pos: "right-0 top-20",
    anim: "animate-float-slow",
    delay: "-3.1s",
  },
  {
    icon: CalendarDays,
    label: "Event budgets",
    pos: "right-2 top-[52%]",
    anim: "animate-float",
    delay: "-1.9s",
  },
  {
    icon: Target,
    label: "Savings goals",
    pos: "right-0 bottom-14",
    anim: "animate-float-slow",
    delay: "-2.2s",
  },
];

const privacyCards = [
  ["Stays on your phone", "Every expense you add is saved on your device, not on our servers."],
  [
    "Nothing to sign up for",
    "No account, no email, no password — you just open the app and start.",
  ],
  ["Only you can see it", "There's no cloud copy for anyone to peek at, leak, or hand over."],
];

// Home slides, "Also included" cards and both pricing columns all come from
// src/data/features.ts — edit a feature there, not here.
const slides = {
  track: feature("track"),
  split: feature("split"),
  plan: feature("plan"),
  events: feature("events"),
  sms: feature("sms"),
};

const freePerks = perksFor("free");
const proPerks = perksFor("pro");
const alsoIncluded = cardsFor();

const softwareAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: APP_NAME,
  description: APP_DESC,
  applicationCategory: "FinanceApplication",
  operatingSystem: "iOS, Android",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base
  title={`${APP_NAME} — ${APP_TAGLINE}`}
  description={APP_DESC}
  path="/"
  jsonLd={[softwareAppJsonLd, faqJsonLd]}
  deck
>
  <div class="min-h-screen overflow-x-hidden bg-background text-foreground">
    <Header />
    <SectionNav client:load />
    <main>
      <!-- Hero -->
      <section id="top" class="relative overflow-hidden">
        <div aria-hidden class="pointer-events-none absolute inset-0 -z-10">
          <div class="absolute -top-24 right-0 h-[700px] w-[900px] translate-x-1/4 hero-glow"></div>
          <div
            class="absolute right-[6%] top-32 h-72 w-72 rounded-full bg-accent-400/40 opacity-60 blur-[80px] animate-blob"
          >
          </div>
          <div
            class="absolute right-[24%] top-72 h-72 w-72 rounded-full bg-accent-500/30 opacity-50 blur-[80px] animate-blob [animation-delay:-6s]"
          >
          </div>
        </div>

        <div
          class="relative mx-auto grid max-w-6xl items-center gap-14 px-6 pt-8 pb-12 lg:grid-cols-2 lg:gap-8 lg:pt-10 lg:pb-14"
        >
          <!-- Left column -->
          <div class="text-left">
            <div class="flex animate-fade-up items-center gap-3">
              <span class="h-px w-10 bg-accent-500"></span>
              <span class="text-xs font-semibold uppercase tracking-[0.2em] text-accent-500">
                Now in private beta
              </span>
            </div>

            <h1
              class="mt-6 max-w-xl animate-fade-up font-display text-5xl leading-[1.02] tracking-tight [animation-delay:120ms] sm:text-6xl lg:text-[4.75rem]"
            >
              Track every expense.
              <br />
              <span class="italic text-accent-500">Trust</span> no server.
            </h1>

            <p
              class="mt-6 max-w-md animate-fade-up text-lg leading-relaxed text-muted-foreground [animation-delay:240ms]"
            >
              A beautifully quiet expense tracker for iOS and Android. Your money story stays sealed
              on your phone — encrypted, offline, and entirely yours.
            </p>

            <div
              id="download"
              class="mt-9 flex animate-fade-up flex-wrap items-center gap-3 [animation-delay:360ms]"
            >
              <a
                href="#"
                aria-label="Download Dotzie on the App Store"
                class="group inline-flex items-center gap-3 rounded-2xl bg-foreground px-5 py-3 text-background transition-all hover:-translate-y-0.5 hover:shadow-xl"
              >
                <svg aria-hidden viewBox="0 0 24 24" class="h-6 w-6 fill-current">
                  <path
                    d="M16.365 1.43c0 1.14-.47 2.24-1.24 3.03-.82.85-2.13 1.5-3.22 1.42-.13-1.09.42-2.24 1.16-3 .82-.85 2.22-1.5 3.3-1.45zM20.5 17.02c-.55 1.27-.81 1.84-1.52 2.96-.99 1.55-2.38 3.48-4.1 3.5-1.54.01-1.94-1-4.03-1-2.09.01-2.53 1.02-4.08 1.01-1.72-.02-3.04-1.76-4.03-3.3C.06 16.4-.02 11.1 2.24 8.3c1.47-1.82 3.55-2.88 5.51-2.88 2.02 0 3.28 1.11 4.95 1.11 1.62 0 2.61-1.11 4.94-1.11 1.76 0 3.62.96 4.95 2.62-4.35 2.38-3.64 8.58-2.09 9.98z"
                  ></path>
                </svg>
                <span class="text-left leading-tight">
                  <span class="block text-[10px] uppercase tracking-widest opacity-70"
                    >Download on the</span
                  >
                  <span class="block text-base font-semibold">App Store</span>
                </span>
              </a>
              <a
                href="#"
                aria-label="Get Dotzie on Google Play"
                class="group inline-flex items-center gap-3 rounded-2xl border border-border bg-card px-5 py-3 transition-all hover:-translate-y-0.5 hover:bg-elevated hover:shadow-xl"
              >
                <svg aria-hidden viewBox="0 0 24 24" class="h-6 w-6">
                  <path
                    d="M3.6 2.2C3.2 2.5 3 3 3 3.6v16.8c0 .6.2 1.1.6 1.4l9.8-9.8L3.6 2.2z"
                    fill="var(--accent-500)"></path>
                  <path
                    d="M17.6 8.4L14.4 6.6 4 1c-.2-.1-.4-.1-.6-.1l10 10L17.6 8.4z"
                    fill="var(--accent-400)"></path>
                  <path
                    d="M21 10.7l-3.4-1.9-3.2 3.2 3.2 3.2 3.4-1.9c1-.5 1-2.1 0-2.6z"
                    fill="var(--accent-700)"></path>
                  <path
                    d="M3.4 22.9c.2 0 .4 0 .6-.1l10.4-5.7 3.2-1.8-3.8-3.8L3.4 22.9z"
                    fill="var(--accent-600)"></path>
                </svg>
                <span class="text-left leading-tight">
                  <span class="block text-[10px] uppercase tracking-widest text-muted-foreground"
                    >Get it on</span
                  >
                  <span class="block text-base font-semibold">Google Play</span>
                </span>
              </a>
            </div>

            <DownloadQR client:visible />

            <p class="mt-6 animate-fade-up text-xs text-muted-foreground [animation-delay:520ms]">
              Free to download. No account. No trackers. No ads.
            </p>
          </div>

          <!-- Right column: featured phone -->
          <div class="relative animate-fade-up [animation-delay:300ms]">
            <div
              aria-hidden
              class="pointer-events-none absolute -inset-6 -z-10 rounded-[3rem] bg-accent-500/20 blur-3xl"
            >
            </div>

            <!-- floating feature chips beside the phone -->
            {
              heroChips.map((c) => {
                const Icon = c.icon;
                return (
                  <div
                    class={`absolute z-20 hidden items-center gap-2 rounded-2xl border border-border bg-card/90 px-3 py-2 shadow-lg backdrop-blur lg:flex ${c.pos} ${c.anim}`}
                    style={`animation-delay:${c.delay}`}
                  >
                    <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-accent-500/10">
                      <Icon className="h-4 w-4 text-accent-500" aria-hidden />
                    </span>
                    <span class="whitespace-nowrap text-xs font-medium text-foreground">
                      {c.label}
                    </span>
                  </div>
                );
              })
            }

            <!-- phone -->
            <div
              class="animate-float relative z-10 mx-auto h-[500px] w-[250px] rounded-[2.6rem] border border-border bg-[#0B0B0F] p-2.5 shadow-2xl ring-1 ring-white/5"
            >
              <div
                class="absolute left-1/2 top-2.5 z-10 h-6 w-24 -translate-x-1/2 rounded-full bg-black/90"
              >
              </div>
              <div
                class="relative h-full w-full overflow-hidden rounded-[2.1rem] bg-[#07070A] text-[#F4F3FA]"
              >
                <div
                  class="flex items-center justify-between px-5 pt-3 text-[10px] font-medium text-white/80"
                >
                  <span>9:41</span>
                  <span class="flex items-center gap-1">
                    <span class="inline-block h-2 w-3 rounded-sm bg-white/70"></span>
                    <span class="inline-block h-2 w-3 rounded-sm bg-white/70"></span>
                  </span>
                </div>

                <div class="px-5">
                  <p class="mt-7 text-[10px] uppercase tracking-widest text-white/40">
                    Balance this month
                  </p>
                  <p class="mt-1 font-display text-[2.75rem] leading-none">
                    $1,240<span class="text-accent-400">.50</span>
                  </p>
                  <p class="mt-2 flex items-center gap-1 text-[11px] font-medium text-accent-300">
                    <span aria-hidden>▼</span> 12% vs last month
                  </p>

                  <div class="mt-7 space-y-2">
                    {
                      heroTxns.map((t) => (
                        <div class="flex items-center gap-3 rounded-xl bg-[#16121F] p-2.5">
                          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/5 text-[15px]">
                            {t.emoji}
                          </span>
                          <div class="flex-1">
                            <p class="text-[12px] font-medium">{t.label}</p>
                            <p class="text-[10px] text-white/50">{t.sub}</p>
                          </div>
                          <p class="text-[12px] text-rose-300">{t.amt}</p>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- App screens showcase -->
      <section id="screens" class="relative mx-auto max-w-6xl px-6 pt-6 lg:pt-8">
        <div class="reveal mx-auto max-w-2xl text-center">
          <p class="text-sm font-medium text-accent-500">A look inside</p>
          <h2 class="mt-2 font-display text-4xl tracking-tight sm:text-5xl">
            Six calm screens. One private app.
          </h2>
        </div>
        <PhoneCarousel client:visible />
      </section>

      <!-- Features slide 1: Track + Split -->
      <section id="track" class="mx-auto max-w-5xl px-6 py-10 lg:py-14">
        <div class="reveal space-y-10 lg:space-y-12">
          <!-- Track (image left) -->
          <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
            <div class="mx-auto w-full max-w-[19rem]">
              <TrackMockup client:visible />
            </div>
            <div>
              <p class="text-sm font-medium text-accent-500">
                {slides.track.slide!.eyebrow}
              </p>
              <h3 class="mt-2 font-display text-2xl leading-tight tracking-tight sm:text-3xl">
                {slides.track.slide!.headline}
              </h3>
              <p class="mt-3 max-w-md leading-relaxed text-muted-foreground">
                {slides.track.slide!.blurb}
              </p>
              <GuideLink feature={slides.track} />
            </div>
          </div>

          <!-- Split (image right) -->
          <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
            <div class="mx-auto w-full max-w-[19rem] lg:order-2">
              <SplitMockup client:visible />
            </div>
            <div class="lg:order-1">
              <p class="text-sm font-medium text-accent-500">
                {slides.split.slide!.eyebrow}
              </p>
              <h3 class="mt-2 font-display text-2xl leading-tight tracking-tight sm:text-3xl">
                {slides.split.slide!.headline}
              </h3>
              <p class="mt-3 max-w-md leading-relaxed text-muted-foreground">
                {slides.split.slide!.blurb}
              </p>
              <GuideLink feature={slides.split} />
            </div>
          </div>
        </div>
      </section>

      <!-- Features slide 2: Plan + Events -->
      <section id="plan" class="mx-auto max-w-5xl px-6 py-10 lg:py-14">
        <div class="reveal space-y-10 lg:space-y-12">
          <!-- Plan (image left) -->
          <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
            <div class="mx-auto w-full max-w-[19rem]">
              <PlanMockup client:visible />
            </div>
            <div>
              <p class="text-sm font-medium text-accent-500">
                {slides.plan.slide!.eyebrow}
              </p>
              <h3 class="mt-2 font-display text-2xl leading-tight tracking-tight sm:text-3xl">
                {slides.plan.slide!.headline}
              </h3>
              <p class="mt-3 max-w-md leading-relaxed text-muted-foreground">
                {slides.plan.slide!.blurb}
              </p>
              <GuideLink feature={slides.plan} />
            </div>
          </div>

          <!-- Events (image right) -->
          <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
            <div class="mx-auto w-full max-w-[19rem] lg:order-2">
              <EventMockup client:visible />
            </div>
            <div class="lg:order-1">
              <p class="text-sm font-medium text-accent-500">
                {slides.events.slide!.eyebrow}
              </p>
              <h3 class="mt-2 font-display text-2xl leading-tight tracking-tight sm:text-3xl">
                {slides.events.slide!.headline}
              </h3>
              <p class="mt-3 max-w-md leading-relaxed text-muted-foreground">
                {slides.events.slide!.blurb}
              </p>
              <GuideLink feature={slides.events} />
            </div>
          </div>
        </div>
      </section>

      <!-- Auto-capture (SMS) + Also included -->
      <section id="included" class="mx-auto max-w-5xl px-6 py-10 lg:py-14">
        <div class="reveal grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
          <div class="mx-auto w-full max-w-[19rem]">
            <SmsMockup client:visible />
          </div>
          <div>
            <p class="text-sm font-medium text-accent-500">
              {slides.sms.slide!.eyebrow}
            </p>
            <h3 class="mt-2 font-display text-2xl leading-tight tracking-tight sm:text-3xl">
              {slides.sms.slide!.headline}
            </h3>
            <p class="mt-3 max-w-md leading-relaxed text-muted-foreground">
              {slides.sms.slide!.blurb}{" "}
              <span class="text-foreground/70">(Android)</span>
            </p>
            <GuideLink feature={slides.sms} />
          </div>
        </div>

        <div class="reveal mt-12">
          <p
            class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground"
          >
            Also included
          </p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              alsoIncluded.map((item) => (
                <div class="rounded-2xl border border-border bg-card p-5 transition-colors hover:border-accent-500/40">
                  <h3 class="text-base font-semibold">{item.card!.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                    {item.card!.desc}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Pricing -->
      <section id="pricing" class="mx-auto max-w-6xl px-6 py-12 lg:py-16">
        <div class="reveal mx-auto max-w-2xl text-center">
          <p class="text-sm font-medium text-accent-500">Free &amp; Pro</p>
          <h2 class="mt-3 font-display text-4xl leading-tight tracking-tight sm:text-5xl">
            Free to start. Pro when you want more.
          </h2>
          <p class="mt-4 text-muted-foreground">
            Try everything free first. Whenever you want the extras, you can switch to Pro right
            inside the app.
          </p>
        </div>

        <div class="reveal mt-10 grid gap-6 lg:grid-cols-2">
          <!-- Free card -->
          <div class="rounded-3xl border border-border bg-card p-8 lg:p-10">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">
              Free
            </p>
            <h3 class="mt-4 font-display text-3xl tracking-tight sm:text-4xl">
              Everything you need to track, privately.
            </h3>
            <ul class="mt-8 space-y-3.5">
              {
                freePerks.map((f) => (
                  <li class="flex items-start gap-3 text-sm">
                    <span aria-hidden class="mt-2 h-px w-4 shrink-0 bg-accent-500" />
                    <span>{f.perk}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Pro card -->
          <div
            class="relative overflow-hidden rounded-3xl border border-transparent bg-[#211613] p-8 text-[#EADBC7] shadow-xl lg:p-10"
          >
            <div
              aria-hidden
              class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-accent-500/40 blur-3xl"
            >
            </div>
            <div class="relative flex items-center gap-3">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/60">Pro</p>
              <span
                class="rounded-full bg-accent-500/20 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-accent-300"
              >
                Coming soon
              </span>
            </div>
            <h3 class="relative mt-4 font-display text-3xl tracking-tight text-white sm:text-4xl">
              A little more insight, when you want it.
            </h3>
            <ul class="relative mt-8 space-y-3.5">
              <li class="flex items-start gap-3 text-sm">
                <Sparkles className="mt-0.5 h-4 w-4 shrink-0 text-accent-400" aria-hidden />
                <span>Everything in Free</span>
              </li>
              {
                proPerks.map((f) => (
                  <li class="flex items-start gap-3 text-sm">
                    <Sparkles className="mt-0.5 h-4 w-4 shrink-0 text-accent-400" aria-hidden />
                    <span>{f.perk}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <p class="reveal mt-8 text-center text-sm text-muted-foreground">
          Upgrades are handled by the App Store and Google Play — never on this website. You'll see
          the price for your country there.
        </p>
      </section>

      <!-- Privacy (dark panel) -->
      <section
        id="privacy"
        class="relative overflow-hidden text-white"
        style="background: color-mix(in oklab, var(--accent-700) 22%, #0b0908);"
      >
        <div aria-hidden class="pointer-events-none absolute inset-0">
          <div
            class="absolute inset-x-0 bottom-0 h-2/3"
            style="background: radial-gradient(65% 80% at 50% 100%, color-mix(in oklab, var(--accent-500) 45%, transparent), transparent 72%);"
          >
          </div>
        </div>
        <div class="relative mx-auto max-w-4xl px-6 py-16 text-center lg:py-20">
          <p class="reveal text-xs font-semibold uppercase tracking-[0.2em] text-accent-400">
            Privacy by design
          </p>
          <h2
            class="reveal mt-4 font-display text-4xl leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl"
          >
            Your data never leaves your device.{" "}
            <span
              class="animate-shimmer-text bg-clip-text italic text-transparent"
              style="background-image: linear-gradient(110deg, var(--accent-300), var(--accent-400), var(--accent-300), var(--accent-400), var(--accent-300));"
            >
              Not by policy — by design.
            </span>
          </h2>
          <p class="reveal mx-auto mt-6 max-w-2xl text-lg text-white/65">
            Every expense is stored and{" "}
            <strong class="font-semibold text-white">kept private right on your phone</strong>.
            There's no account to sign up for and nothing syncing to the cloud, so there's nothing
            to leak, sell, or hand over. The only person who can ever see your spending is you.
          </p>

          <dl class="reveal mx-auto mt-14 grid max-w-3xl gap-6 text-left sm:grid-cols-3">
            {
              privacyCards.map(([k, v]) => (
                <div class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-all duration-500 hover:-translate-y-1 hover:border-accent-400/50 hover:bg-white/[0.07]">
                  <dt class="font-display text-xl text-white">{k}</dt>
                  <dd class="mt-2 text-sm text-white/60">{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="mx-auto max-w-3xl px-6 py-12 lg:py-16">
        <p class="reveal text-sm font-medium text-accent-500">Frequently asked</p>
        <h2 class="reveal mt-3 font-display text-4xl tracking-tight sm:text-5xl">
          Questions, answered.
        </h2>

        <div class="reveal mt-10 divide-y divide-border border-t border-b border-border">
          {
            faqs.map((f) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-left text-base font-medium transition-colors hover:text-accent-500 [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <svg
                    class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="pb-4 text-muted-foreground">{f.a}</p>
              </details>
            ))
          }
        </div>

        <div
          class="reveal mt-14 flex items-center justify-between rounded-2xl border border-border bg-card p-6 transition-colors hover:border-accent-500/40"
        >
          <div>
            <p class="font-semibold">Still curious?</p>
            <p class="text-sm text-muted-foreground">Read the user guide.</p>
          </div>
          <a
            href="/guide"
            class="group inline-flex items-center gap-2 text-sm font-medium text-accent-500 hover:text-accent-400"
          >
            Open the guide
            <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
