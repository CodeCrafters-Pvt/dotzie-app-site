---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { PhoneCarousel } from "@/components/islands/PhoneCarousel";
import { faqs } from "@/data/faq";
import {
  Wifi,
  Database,
  ServerOff,
  Zap,
  Sparkles,
  LayoutGrid,
  ArrowRight,
  QrCode,
} from "lucide-react";

const APP_NAME = "Dotzie";
const APP_TAGLINE = "Offline-first, privacy-first expense tracker";
const APP_DESC =
  "Dotzie is an offline-first expense tracker. All your financial data stays encrypted on your device — no cloud, no server, no accounts.";

const features = [
  { icon: Wifi, title: "Offline-first", desc: "Every tap, chart, and export works with airplane mode on. The network is optional, always." },
  { icon: Database, title: "Encrypted local backup", desc: "Portable backup files are sealed with AES-256-GCM and a passphrase only you know." },
  { icon: ServerOff, title: "No cloud, no server", desc: "There is no Dotzie account. Nothing to breach, nothing to subpoena, nothing to sync." },
  { icon: Zap, title: "Fast and lightweight", desc: "A native React Native build that cold-starts in under a second on modest hardware." },
  { icon: Sparkles, title: "Smart categories", desc: "On-device rules learn your habits and pre-fill categories without sending a byte off the phone." },
  { icon: LayoutGrid, title: "Clean, calm UI", desc: "A quiet interface designed to fade into your day — not compete with it for attention." },
];

const privacyCards = [
  ["AES-256-GCM", "Authenticated encryption for every record on disk."],
  ["Zero network calls", "The app makes no requests once installed."],
  ["No accounts", "Nothing to sign up for, nothing to leak."],
];

const softwareAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: APP_NAME,
  description: APP_DESC,
  applicationCategory: "FinanceApplication",
  operatingSystem: "iOS, Android",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base
  title={`${APP_NAME} — ${APP_TAGLINE}`}
  description={APP_DESC}
  path="/"
  jsonLd={[softwareAppJsonLd, faqJsonLd]}
>
  <div class="min-h-screen overflow-x-hidden bg-background text-foreground">
    <Header />
    <main>
      <!-- Hero -->
      <section id="top" class="relative overflow-hidden">
        <div aria-hidden class="pointer-events-none absolute inset-0 -z-10">
          <div class="absolute -top-24 left-1/2 h-[700px] w-[900px] -translate-x-1/2 hero-glow"></div>
          <div class="absolute left-[10%] top-40 h-72 w-72 rounded-full bg-accent-500/40 opacity-60 blur-[80px] animate-blob"></div>
          <div class="absolute right-[8%] top-64 h-80 w-80 rounded-full bg-accent-400/40 opacity-60 blur-[80px] animate-blob [animation-delay:-6s]"></div>
        </div>

        <div class="relative mx-auto max-w-6xl px-6 pt-20 pb-16 text-center lg:pt-28">
          <div class="animate-fade-up">
            <span class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-3 py-1 text-xs text-muted-foreground backdrop-blur">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full rounded-full bg-accent-500 animate-pulse-ring"></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-500"></span>
              </span>
              Now in private beta
            </span>
          </div>

          <h1 class="mx-auto mt-8 max-w-4xl animate-fade-up font-display text-5xl leading-[1.02] tracking-tight [animation-delay:120ms] sm:text-6xl lg:text-[5.5rem]">
            Track every expense.
            <br />
            <span
              class="animate-shimmer-text bg-clip-text italic text-transparent"
              style="background-image: linear-gradient(110deg, var(--accent-400), var(--accent-600), var(--accent-300), var(--accent-600), var(--accent-400));"
            >
              Trust no server.
            </span>
          </h1>

          <p class="mx-auto mt-6 max-w-2xl animate-fade-up text-lg text-muted-foreground [animation-delay:240ms]">
            A beautifully quiet expense tracker for iOS and Android. Your money
            story stays sealed on your phone — encrypted, offline, and entirely
            yours.
          </p>

          <div id="download" class="mt-10 flex animate-fade-up flex-wrap items-center justify-center gap-3 [animation-delay:360ms]">
            <a
              href="#"
              aria-label="Download Dotzie on the App Store"
              class="group inline-flex items-center gap-3 rounded-2xl bg-foreground px-5 py-3 text-background transition-all hover:-translate-y-0.5 hover:shadow-xl"
            >
              <svg aria-hidden viewBox="0 0 24 24" class="h-6 w-6 fill-current">
                <path d="M16.365 1.43c0 1.14-.47 2.24-1.24 3.03-.82.85-2.13 1.5-3.22 1.42-.13-1.09.42-2.24 1.16-3 .82-.85 2.22-1.5 3.3-1.45zM20.5 17.02c-.55 1.27-.81 1.84-1.52 2.96-.99 1.55-2.38 3.48-4.1 3.5-1.54.01-1.94-1-4.03-1-2.09.01-2.53 1.02-4.08 1.01-1.72-.02-3.04-1.76-4.03-3.3C.06 16.4-.02 11.1 2.24 8.3c1.47-1.82 3.55-2.88 5.51-2.88 2.02 0 3.28 1.11 4.95 1.11 1.62 0 2.61-1.11 4.94-1.11 1.76 0 3.62.96 4.95 2.62-4.35 2.38-3.64 8.58-2.09 9.98z"></path>
              </svg>
              <span class="text-left leading-tight">
                <span class="block text-[10px] uppercase tracking-widest opacity-70">Download on the</span>
                <span class="block text-base font-semibold">App Store</span>
              </span>
            </a>
            <a
              href="#"
              aria-label="Get Dotzie on Google Play"
              class="group inline-flex items-center gap-3 rounded-2xl border border-border bg-card px-5 py-3 transition-all hover:-translate-y-0.5 hover:bg-elevated hover:shadow-xl"
            >
              <svg aria-hidden viewBox="0 0 24 24" class="h-6 w-6">
                <path d="M3.6 2.2C3.2 2.5 3 3 3 3.6v16.8c0 .6.2 1.1.6 1.4l9.8-9.8L3.6 2.2z" fill="#6B5CFF"></path>
                <path d="M17.6 8.4L14.4 6.6 4 1c-.2-.1-.4-.1-.6-.1l10 10L17.6 8.4z" fill="#8A7EFF"></path>
                <path d="M21 10.7l-3.4-1.9-3.2 3.2 3.2 3.2 3.4-1.9c1-.5 1-2.1 0-2.6z" fill="#4A3FCC"></path>
                <path d="M3.4 22.9c.2 0 .4 0 .6-.1l10.4-5.7 3.2-1.8-3.8-3.8L3.4 22.9z" fill="#5D50EC"></path>
              </svg>
              <span class="text-left leading-tight">
                <span class="block text-[10px] uppercase tracking-widest text-muted-foreground">Get it on</span>
                <span class="block text-base font-semibold">Google Play</span>
              </span>
            </a>
            <div
              aria-label="QR code to download Dotzie"
              class="flex h-16 w-16 items-center justify-center rounded-xl border border-dashed border-border bg-card text-muted-foreground transition-colors hover:text-foreground"
            >
              <QrCode className="h-6 w-6" />
            </div>
          </div>

          <p class="mt-4 animate-fade-up text-xs text-muted-foreground [animation-delay:480ms]">
            Free to download. No account. No trackers. No ads.
          </p>
        </div>

        <PhoneCarousel client:visible />
      </section>

      <!-- Features -->
      <section id="features" class="mx-auto max-w-6xl px-6 py-24 lg:py-32">
        <div class="reveal max-w-2xl">
          <p class="text-sm font-medium text-accent-500">What's inside</p>
          <h2 class="mt-3 font-display text-4xl tracking-tight sm:text-5xl">
            Every feature built for a phone that trusts itself.
          </h2>
          <p class="mt-4 text-muted-foreground">
            No dashboards to log into, no companies to trust. Dotzie runs
            entirely on your device — the app is the product, not the pipeline
            behind it.
          </p>
        </div>

        <ul class="reveal mt-14 grid gap-px overflow-hidden rounded-3xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map((f) => {
              const Icon = f.icon;
              return (
                <li class="group relative overflow-hidden bg-card p-8 transition-all duration-500 hover:bg-elevated">
                  <span aria-hidden class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-accent-500/0 blur-2xl transition-all duration-700 group-hover:bg-accent-500/30" />
                  <span class="relative inline-flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-background transition-transform duration-500 group-hover:-translate-y-1 group-hover:border-accent-500/50">
                    <Icon className="h-5 w-5 text-accent-500" aria-hidden />
                  </span>
                  <h3 class="relative mt-6 text-lg font-semibold">{f.title}</h3>
                  <p class="relative mt-2 text-sm leading-relaxed text-muted-foreground">{f.desc}</p>
                </li>
              );
            })
          }
        </ul>
      </section>

      <!-- Privacy -->
      <section id="privacy" class="relative overflow-hidden">
        <div aria-hidden class="absolute inset-0 -z-10">
          <div class="absolute left-[15%] top-1/3 h-64 w-64 rounded-full bg-accent-500/30 blur-[80px] animate-blob"></div>
          <div class="absolute right-[10%] top-1/2 h-72 w-72 rounded-full bg-accent-400/30 blur-[80px] animate-blob [animation-delay:-8s]"></div>
        </div>
        <div class="relative mx-auto max-w-4xl px-6 py-24 text-center lg:py-32">
          <p class="reveal text-sm font-medium text-accent-500">Privacy, plainly</p>
          <h2 class="reveal mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl lg:text-6xl">
            Your data never leaves your device.{" "}
            <span
              class="animate-shimmer-text bg-clip-text italic text-transparent"
              style="background-image: linear-gradient(110deg, var(--accent-400), var(--accent-600), var(--accent-300), var(--accent-600), var(--accent-400));"
            >
              Full stop.
            </span>
          </h2>
          <p class="reveal mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
            Every transaction, note, and category you enter is written to an
            on-device database encrypted with{" "}
            <strong class="text-foreground">AES-256-GCM</strong>. There is no
            Dotzie server to send it to, and no analytics SDK quietly listening
            in the background.
          </p>

          <dl class="reveal mx-auto mt-14 grid max-w-3xl gap-6 text-left sm:grid-cols-3">
            {
              privacyCards.map(([k, v]) => (
                <div class="rounded-2xl border border-border bg-card p-5 transition-transform duration-500 hover:-translate-y-1 hover:border-accent-500/50">
                  <dt class="font-display text-xl">{k}</dt>
                  <dd class="mt-2 text-sm text-muted-foreground">{v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="mx-auto max-w-3xl px-6 py-24 lg:py-32">
        <p class="reveal text-sm font-medium text-accent-500">Frequently asked</p>
        <h2 class="reveal mt-3 font-display text-4xl tracking-tight sm:text-5xl">
          Questions, answered.
        </h2>

        <div class="reveal mt-10 divide-y divide-border border-t border-b border-border">
          {
            faqs.map((f) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-left text-base font-medium transition-colors hover:text-accent-500 [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <svg
                    class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="pb-4 text-muted-foreground">{f.a}</p>
              </details>
            ))
          }
        </div>

        <div class="reveal mt-14 flex items-center justify-between rounded-2xl border border-border bg-card p-6 transition-colors hover:border-accent-500/40">
          <div>
            <p class="font-semibold">Still curious?</p>
            <p class="text-sm text-muted-foreground">Read the user guide.</p>
          </div>
          <a href="/guide" class="group inline-flex items-center gap-2 text-sm font-medium text-accent-500 hover:text-accent-400">
            Open the guide
            <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>
