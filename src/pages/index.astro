---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
import SectionScroll from "@/components/SectionScroll.astro";
import ScrollRail from "@/components/ScrollRail.astro";
import { SectionNav } from "@/components/islands/SectionNav";
import { MeetDotzie } from "@/components/islands/MeetDotzie";
import Screens from "@/components/home/Screens.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/home/Hero.astro";
import TabbedSlide from "@/components/home/TabbedSlide.astro";
import FeatureBlock from "@/components/home/FeatureBlock.astro";
import {
  TrackMockup,
  SplitMockup,
  PlanMockup,
  EventMockup,
  SmsMockup,
} from "@/components/islands/FeatureMockups";
import AlsoIncluded from "@/components/home/AlsoIncluded.astro";
import Pricing from "@/components/home/Pricing.astro";
import PrivacyPanel from "@/components/home/PrivacyPanel.astro";
import Faq from "@/components/home/Faq.astro";
import { faqs } from "@/data/faq";
import { SITE_NAME, SITE_TAGLINE, SITE_DESC } from "@/data/site";

const softwareAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE_NAME,
  description: SITE_DESC,
  applicationCategory: "FinanceApplication",
  operatingSystem: "iOS, Android",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base
  title={`${SITE_NAME} - ${SITE_TAGLINE}`}
  description={SITE_DESC}
  path="/"
  jsonLd={[softwareAppJsonLd, faqJsonLd]}
  snap
>
  <div class="min-h-screen overflow-x-clip bg-background text-foreground">
    <Header />
    <SectionNav client:load />
    <ScrollRail />
    <MeetDotzie client:load />

    <main class="quiet-home">
      <Hero />
      <Screens />

      <TabbedSlide id="track" tabs={["Tracking", "Splitting"]}>
        <FeatureBlock slot="one" id="track"><TrackMockup client:visible /></FeatureBlock>
        <FeatureBlock slot="two" id="split" flip><SplitMockup client:visible /></FeatureBlock>
      </TabbedSlide>

      <TabbedSlide id="plan" tabs={["Planning", "Events"]}>
        <FeatureBlock slot="one" id="plan"><PlanMockup client:visible /></FeatureBlock>
        <FeatureBlock slot="two" id="events" flip><EventMockup client:visible /></FeatureBlock>
      </TabbedSlide>

      <TabbedSlide id="included" tabs={["Auto-capture", "Extras"]}>
        <FeatureBlock slot="one" id="sms" note="(Android)">
          <SmsMockup client:visible />
        </FeatureBlock>
        <AlsoIncluded slot="two" />
      </TabbedSlide>
      <PrivacyPanel />
      <Pricing />
      <Faq />
      <Footer />
    </main>
  </div>
  <SectionScroll />
</Base>
