---
import Base from "@/layouts/Base.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Base
  title="Terms of Service — Dotzie"
  description="The terms that apply when you use the Dotzie mobile app."
  path="/terms"
>
  <div class="min-h-screen bg-background text-foreground">
    <Header />
    <main class="mx-auto max-w-3xl px-6 py-24">
      <a href="/" class="text-sm text-accent-500 hover:text-accent-400">← Back home</a>
      <h1 class="mt-6 font-display text-5xl tracking-tight">Terms of Service</h1>
      <p class="mt-4 text-sm text-muted-foreground">
        <!-- TODO: set the real last-updated date before launch. -->
        Last updated: —
      </p>
      <div class="mt-10 space-y-4 text-muted-foreground">
        <p>
          <!-- TODO: replace with real Terms of Service before public launch. -->
          These are placeholder terms. Replace this content with your reviewed Terms of Service before
          the app is publicly released.
        </p>
      </div>
    </main>
    <Footer />
  </div>
</Base>
